source ~/turtlebot3_ws/install/setup.bash
source ~/roscommon/ws_moveit2/install/setup.bash
source ~/webots_ws/install/setup.bash
# $1 is a world filename relative to turtlebot3_lime_webots/worlds/ (e.g. sim_house.wbt).
# $2 is a map yaml file, same as before.
ros2 launch turtlebot3_lime_webots robot_launch.py world:=$1 &
sleep 5
ros2 launch turtlebot3_lime_moveit_config servo.launch.py use_sim:=true &
sleep 1
ros2 launch turtlebot3_lime_bringup moveit_navigation_use_sim_time.launch.py map_yaml_file:=$2
